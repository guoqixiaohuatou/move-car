/* 空白码绑定提示 */
.bind-tip {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  background: #f0f7ff;
  border: 2rpx solid var(--brand-light);
}

.bind-tip__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 12rpx;
}

.bind-tip__text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.field {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.field:last-child {
  border-bottom: none;
}

.field__label {
  font-size: 26rpx;
  color: var(--text-2);
  margin-bottom: 16rpx;
}

.field__req {
  color: var(--danger);
  margin-left: 6rpx;
}

.field__opt {
  color: var(--text-3);
  margin-left: 12rpx;
  font-size: 24rpx;
  font-weight: 400;
}

.field__input {
  font-size: 36rpx;
  color: var(--text-1);
  height: 72rpx;
  line-height: 72rpx;
}

.field__ph {
  font-size: 30rpx;
  color: var(--text-3);
}

.field__tip {
  font-size: 23rpx;
  color: var(--text-3);
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ========== 车牌输入器 ========== */
.plate {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid;
  transition: all 0.25s ease;
}

/* 普通燃油车：蓝色系 */
.plate--blue {
  border-color: #1677ff;
  box-shadow: 0 6rpx 24rpx rgba(22, 119, 255, 0.12);
}

/* 新能源车：绿色系 */
.plate--green {
  border-color: #52c41a;
  box-shadow: 0 6rpx 24rpx rgba(82, 196, 26, 0.14);
}

.plate__province {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 88rpx;
  border-radius: 16rpx;
  color: #ffffff;
  transition: background 0.25s ease;
  flex-shrink: 0;
}

.plate--blue .plate__province {
  background: linear-gradient(135deg, #3c8dff, #1677ff);
}

.plate--green .plate__province {
  background: linear-gradient(135deg, #73d13d, #52c41a);
}

.plate__province-text {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1;
}

.plate__province-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  border-top: 8rpx solid rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}

.plate__split {
  width: 2rpx;
  height: 56rpx;
  background: var(--line);
  margin: 0 18rpx;
}

.plate__body {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  min-width: 0;
}

.plate__box {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1 1 0;
  min-width: 36rpx;
  max-width: 56rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #f7f8fa;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

/* 第 7 格（新能源位）：未填时虚线提示，填了自动变绿牌 */
.plate__box--energy {
  background: #fafbfc;
  border-style: dashed;
  border-color: var(--text-3);
}

.plate--blue .plate__box--focus {
  background: #e8f2ff;
  border-color: #1677ff;
  box-shadow: 0 0 0 4rpx rgba(22, 119, 255, 0.15);
}

.plate--green .plate__box--focus {
  background: #f6ffed;
  border-color: #52c41a;
  box-shadow: 0 0 0 4rpx rgba(82, 196, 26, 0.15);
}

.plate__char {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-1);
  font-family: 'SF Mono', 'Roboto Mono', Menlo, Consolas, monospace;
}

.plate__dot {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-3);
  margin: 0 4rpx;
  line-height: 1;
  flex-shrink: 0;
}

/* 真实输入框：放到屏幕外，只负责接收键盘输入，不显示文字 */
.plate__real-input {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1rpx;
  height: 1rpx;
  opacity: 0;
  pointer-events: none;
  color: transparent;
  caret-color: transparent;
  font-size: 0;
}

/* ========== 省份选择面板 ========== */
.province-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  z-index: 100;
  transition: background 0.25s ease;
}

.province-mask--show {
  background: rgba(0, 0, 0, 0.45);
  pointer-events: auto;
}

.province-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.province-panel--show {
  transform: translateY(0);
}

.province-panel__hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.province-panel__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.province-panel__done {
  font-size: 30rpx;
  color: var(--brand);
  padding: 8rpx 16rpx;
}

.province-panel__bd {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx 32rpx;
  gap: 16rpx;
}

.province-panel__item {
  display: flex;
  align-items: center;
  justify-content: center;
  width: calc((100% - 80rpx) / 6);
  height: 88rpx;
  border-radius: 16rpx;
  background: #f2f4f8;
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-1);
  transition: all 0.15s ease;
}

.province-panel__item:active {
  opacity: 0.7;
  transform: scale(0.96);
}

.province-panel__item--active {
  background: var(--brand);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(22, 119, 255, 0.28);
}

.province-panel__safe {
  background: #ffffff;
}

/* ========== 隐私说明卡片 ========== */
.notice {
  background: #f6f9ff;
  border: none;
}

.notice__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-dark);
  margin-bottom: 8rpx;
}

.notice__text {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.notice__link {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--brand);
  text-decoration: underline;
}
