.page {
  padding: 32rpx 32rpx 96rpx;
}

.tip {
  margin-bottom: 24rpx;
  padding: 28rpx 32rpx;
  background: #fff7e6;
  border: 2rpx solid #ffc069;
}

.tip__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #d46b08;
  margin-bottom: 12rpx;
}

.tip__text {
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
  margin-bottom: 12rpx;
}

.tip__warn {
  font-size: 24rpx;
  color: #ad6800;
  line-height: 1.6;
}

/* 出码版本提示：正式版绿（可印），体验版橙（会作废） */
.tip__env {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.tip__env--release {
  background: #f0f9eb;
  color: #2b7a0b;
}

.tip__env--trial {
  background: #fff7e6;
  color: #ad6800;
}

.save-all {
  margin-bottom: 32rpx;
}

.grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.blank-card {
  padding: 28rpx 32rpx;
}

.blank-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.blank-card__no {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.blank-card__hint {
  font-size: 22rpx;
}

.qr-box {
  width: 460rpx;
  height: 460rpx;
  margin: 0 auto;
  background: #ffffff;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.qr-box__img {
  width: 100%;
  height: 100%;
}

.qr-box--loading {
  font-size: 24rpx;
}

.qr-card__hint {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
}

.blank-card__id {
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  word-break: break-all;
}

.blank-card__actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
}

.btn--sm {
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

.foot-link {
  margin-top: 48rpx;
  text-align: center;
  font-size: 26rpx;
}